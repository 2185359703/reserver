# Set these as environment variables before running; this file is documentation only.
# Python does not automatically load .env files.
GEETEST_CAPTCHA_ID=
# Optional: empty means a new UUID challenge for each /load request.
GEETEST_CHALLENGE=
GEETEST_COOKIE=
GEETEST_REFERER=https://www.geetest.com/

# Required only when calling the vision model or running full automatic recognition.
# Use your provider's OpenAI-compatible base URL (including /v1 if required).
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
